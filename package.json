{
  "name": "ipo-agent",
  "version": "1.0.0",
  "description": "IPO S-1 Agent using Mastra for intelligent document processing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "process-s1": "npm run build && node dist/processor/process-s1.js",
    "ingest:edgar": "npm run build && node dist/scripts/ingestEdgarS1.js",
    "s1:up": "npm run build && node dist/scripts/s1Up.js",
    "embed": "npm run build && node dist/embeddings/generate-embeddings.js",
    "facts": "npm run build && node dist/scripts/extractFacts.js",
    "query": "npm run build && node dist/query.js",
    "query-structured": "npm run build && node dist/query-structured.js",
    "generate-report": "npm run build && node dist/scripts/generateInvestmentReport.js",
    "test-workflow": "npm run build && node dist/test-workflow.js",
    "init-search": "npm run build && node dist/scripts/initializeHybridSearch.js",
    "validate-report": "npm run build && node dist/scripts/validateReport.js",
    "test-financial-agent": "tsx examples/agent_quick_check.ts",
    "preview-table-tool": "tsx examples/table_tool_preview.ts",
    "test": "npm run build && node --test tests/*.test.js",
    "mastra:dev": "mastra dev"
  },
  "keywords": [
    "ipo",
    "s1",
    "mastra",
    "rag",
    "agent",
    "financial"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "1.3.22",
    "@mastra/core": "^0.10.10",
    "@mastra/memory": "^0.11.1",
    "@mastra/pg": "0.12.1",
    "@mastra/rag": "1.0.1",
    "ai": "^4.0.0",
    "cheerio": "1.2.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
