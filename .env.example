###############################################
# IPO Agent Environment (copy to .env)
###############################################

# required for LLM-based workloads (embeddings, agents)
OPENAI_API_KEY=...

# required for vector search (pgvector)
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/ipo_agent

# optional: tweak framework logging
MASTRA_LOG_LEVEL=info
