###############################################
# IPO Agent Environment (copy to .env)
###############################################

# required for LLM-based workloads (embeddings, agents)
OPENAI_API_KEY=...

# required for vector search (pgvector)
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/ipo_agent

# required for SEC ingestion (EDGAR blocks generic user agents)
SEC_USER_AGENT="Your Name <you@example.com>"

# active filing (one S-1 at a time)
S1_FILING_ID=figma

# optional: used by prompts and report generation
S1_COMPANY_NAME="Company"

# output root (filing outputs are written to: $S1_OUTPUT_ROOT/filings/$S1_FILING_ID)
S1_OUTPUT_ROOT=output

# optional: override input content list for processing (defaults to ./figmas1_content_list.json)
# S1_CONTENT_LIST_PATH=figmas1_content_list.json

# optional: cite/source URL associated with the active filing
# S1_SOURCE_URL=

# optional: pgvector index name (default: s1_embeddings)
# S1_VECTOR_INDEX=s1_embeddings

# optional: tweak framework logging
MASTRA_LOG_LEVEL=info
